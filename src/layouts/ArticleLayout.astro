---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HalteTable from '../components/HalteTable.astro';
import FAQSection from '../components/FAQSection.astro';
import AdSlot from '../components/AdSlot.astro';
import { siteConfig } from '../config/site';

interface RelatedArticle {
  slug: string;
  title: string;
  description: string;
  category: 'trans-jogja' | 'kereta-bandara' | 'tiket-wisata';
  featuredImage: string;
  routeType: string;
  fare: string;
}

interface Props {
  title: string;
  description: string;
  category: 'trans-jogja' | 'kereta-bandara' | 'tiket-wisata';
  publishDate: string;
  updatedDate?: string;
  author?: string;
  featuredImage: string;
  imageAlt: string;
  halteList?: { name: string; location?: string; transit?: string }[];
  operationalHours: string;
  fare: string;
  routeType: string;
  faqs: { question: string; answer: string }[];
  relatedArticles?: RelatedArticle[];
}

const {
  title,
  description,
  category,
  publishDate,
  updatedDate,
  author = siteConfig.author,
  featuredImage,
  imageAlt,
  halteList = [],
  operationalHours,
  fare,
  routeType,
  faqs = [],
  relatedArticles = []
} = Astro.props;

const categoryInfo = siteConfig.categories.find(c => c.slug === category) || {
  slug: category,
  name: category,
  color: 'blue'
};

const breadcrumbs = [
  { name: categoryInfo.name, url: `${siteConfig.url}/kategori/${categoryInfo.slug}/` },
  { name: title, url: `${siteConfig.url}/panduan/${Astro.params.slug}/` }
];

const formattedDate = new Date(publishDate).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout
  title={`${title} — ${siteConfig.name}`}
  description={description}
  image={featuredImage}
  article={true}
  publishDate={publishDate}
  updatedDate={updatedDate}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbs.map(b => ({ label: b.name, href: b.url }))} />

    <!-- Article Header -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <a
          href={`/kategori/${categoryInfo.slug}`}
          class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200 hover:bg-brand-100 transition-colors"
        >
          {categoryInfo.name}
        </a>
        <span class="text-xs text-slate-400">&bull;</span>
        <span class="text-xs font-medium text-slate-500">{routeType}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-navy-900 tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6 font-normal">
        {description}
      </p>

      <!-- Meta Author & Date -->
      <div class="flex flex-wrap items-center justify-between gap-4 py-3 border-y border-slate-200 text-xs sm:text-sm text-slate-500">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-navy-900 text-white flex items-center justify-center font-bold text-xs">
            PRJ
          </div>
          <div>
            <span class="font-semibold text-slate-800 block">{author}</span>
            <span class="text-xs text-slate-400">Tim Redaksi & Observasi Lapangan</span>
          </div>
        </div>

        <div class="flex items-center gap-4 text-xs">
          <span>Diterbitkan: <strong class="text-slate-700">{formattedDate}</strong></span>
          <span class="inline-flex items-center gap-1 text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded font-medium">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Faktual & Terverifikasi
          </span>
        </div>
      </div>
    </header>

    <!-- Quick Transit Summary Card -->
    <div class="my-6 bg-gradient-to-br from-brand-50 via-white to-slate-50 border border-brand-200/80 rounded-2xl p-5 shadow-sm">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-700 mb-3 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Ringkasan Operasional Cepat
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
        <div class="bg-white p-3.5 rounded-xl border border-slate-100 shadow-2xs">
          <span class="text-xs text-slate-400 block mb-0.5 font-medium">Jam Operasional</span>
          <span class="font-bold text-navy-900">{operationalHours}</span>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-slate-100 shadow-2xs">
          <span class="text-xs text-slate-400 block mb-0.5 font-medium">Tarif Resmi</span>
          <span class="font-bold text-brand-700">{fare}</span>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-slate-100 shadow-2xs">
          <span class="text-xs text-slate-400 block mb-0.5 font-medium">Tipe Layanan</span>
          <span class="font-bold text-navy-900">{routeType}</span>
        </div>
      </div>
    </div>

    <!-- Featured Image -->
    {featuredImage && (
      <div class="my-8 rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100">
        <img
          src={featuredImage}
          alt={imageAlt || title}
          class="w-full h-auto object-cover max-h-[420px]"
          loading="lazy"
        />
        <div class="p-2 text-center text-xs text-slate-400 bg-white border-t border-slate-100">
          Ilustrasi visual & diagram rute: {title}
        </div>
      </div>
    )}

    <!-- In-Article Middle Ad (Safe pre-approval mode) -->
    <AdSlot slotType="in-article" />

    <!-- Main Content Prose -->
    <article class="prose-transit">
      <slot />
    </article>

    <!-- Halte / Station Table -->
    {halteList && halteList.length > 0 && (
      <HalteTable haltes={halteList} title={`Daftar Halte & Rute ${title}`} />
    )}

    <!-- In-Article Bottom Ad (Safe pre-approval mode) -->
    <AdSlot slotType="in-article-bottom" />

    <!-- FAQ Accordion -->
    {faqs && faqs.length > 0 && (
      <FAQSection faqs={faqs} title={`Pertanyaan Umum (FAQ) — ${title}`} />
    )}

    <!-- Kotak Transit Disclaimer & Official Notice (Anti-Misrepresentation AdSense Policy) -->
    <div class="my-10 p-5 rounded-2xl bg-amber-50/80 border border-amber-200/90 text-amber-950 text-xs sm:text-sm leading-relaxed shadow-2xs">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-amber-200/80 text-amber-800 flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-amber-900 text-sm mb-1">
            Pemberitahuan Resmi & Batasan Tanggung Jawab Informasi
          </h4>
          <p class="text-xs sm:text-sm text-amber-900/90 leading-relaxed">
            <strong>PanduanRuteJogja.com</strong> adalah portal panduan independen utilitas publik dan <strong>bukan merupakan situs resmi</strong> milik Dinas Perhubungan D.I. Yogyakarta, PT Kereta Api Indonesia (Persero), KAI Commuter, maupun PT Railink. Jadwal keberangkatan, rute persilangan, dan tarif resmi dapat disesuaikan sewaktu-waktu oleh otoritas perhubungan terkait kondisi lalu lintas atau regulasi dinas. Selalu lakukan konfirmasi jadwal langsung di stasiun/halte atau via aplikasi resmi (Access by KAI / KRL Access).
          </p>
        </div>
      </div>
    </div>

    <!-- Editorial Integrity / Author Box (AdSense E-E-A-T) -->
    <div class="mt-8 p-6 bg-slate-100/90 rounded-2xl border border-slate-200 shadow-2xs">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-brand-700 to-navy-900 text-white flex items-center justify-center font-bold text-base shadow-sm flex-shrink-0">
          PRJ
        </div>
        <div class="flex-1">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h4 class="text-base font-bold text-navy-900">Ditinjau oleh Dewan Redaksi PanduanRuteJogja</h4>
            <a href="/redaksi" class="text-xs font-semibold text-brand-600 hover:text-brand-800 underline">
              Lihat Profil Penulis & Editor &rarr;
            </a>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed">
            Artikel panduan ini disusun berdasarkan observasi lapangan, pengecekan berkala Gapeka KAI Commuter, regulasi Dinas Perhubungan D.I. Yogyakarta, serta pengujian rute halte secara langsung untuk akurasi data mobilitas publik.
          </p>
        </div>
      </div>
    </div>

    <!-- Rekomendasi Panduan Rute Terkait (AdSense Navigational Value & Low Bounce Rate) -->
    {relatedArticles && relatedArticles.length > 0 && (
      <section class="mt-14 pt-10 border-t border-slate-200">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
          <div>
            <h3 class="text-xl font-extrabold text-navy-900 tracking-tight">
              Panduan Rute Terkait & Lanjutan Perjalanan
            </h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Jelajahi panduan rute transportasi umum lainnya yang terintegrasi di wilayah D.I. Yogyakarta.
            </p>
          </div>
          <a
            href={`/kategori/${categoryInfo.slug}`}
            class="text-xs font-bold text-brand-600 hover:text-brand-800 transition-colors inline-flex items-center gap-1"
          >
            <span>Semua di {categoryInfo.name}</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {relatedArticles.map((rel) => (
            <a
              href={`/panduan/${rel.slug}`}
              class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-2xs hover:shadow-md hover:border-brand-300 transition-all flex flex-col justify-between"
            >
              <div>
                <div class="aspect-[16/9] w-full overflow-hidden bg-slate-100 border-b border-slate-100 relative">
                  <img
                    src={rel.featuredImage}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-navy-900/80 text-white backdrop-blur-xs">
                    {rel.routeType}
                  </span>
                </div>
                <div class="p-4">
                  <h4 class="text-sm font-bold text-navy-900 group-hover:text-brand-600 transition-colors line-clamp-2 leading-snug mb-2">
                    {rel.title}
                  </h4>
                  <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                    {rel.description}
                  </p>
                </div>
              </div>
              <div class="px-4 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="font-bold text-brand-700">{rel.fare}</span>
                <span class="font-medium text-slate-500 group-hover:text-navy-900 flex items-center gap-1">
                  Baca Panduan &rarr;
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation Back to Category & Home -->
    <div class="mt-12 pt-6 border-t border-slate-200 flex justify-between items-center text-sm">
      <a
        href={`/kategori/${categoryInfo.slug}`}
        class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-800 font-semibold transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Kembali ke Panduan {categoryInfo.name}
      </a>
      <a
        href="/#panduan-list"
        class="text-slate-500 hover:text-navy-900 transition-colors"
      >
        Semua Panduan Rute &rarr;
      </a>
    </div>

  </div>
</BaseLayout>
