---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HalteTable from '../components/HalteTable.astro';
import RouteStrip from '../components/RouteStrip.astro';
import FAQSection from '../components/FAQSection.astro';
import AdSlot from '../components/AdSlot.astro';
import { siteConfig } from '../config/site';

interface RelatedArticle {
  slug: string;
  title: string;
  description: string;
  category: 'trans-jogja' | 'kereta-bandara' | 'tiket-wisata';
  featuredImage: string;
  routeType: string;
  fare: string;
}

interface Props {
  title: string;
  description: string;
  category: 'trans-jogja' | 'kereta-bandara' | 'tiket-wisata';
  publishDate: string;
  updatedDate?: string;
  author?: string;
  featuredImage: string;
  imageAlt: string;
  halteList?: { name: string; location?: string; transit?: string }[];
  operationalHours: string;
  fare: string;
  routeType: string;
  faqs: { question: string; answer: string }[];
  relatedArticles?: RelatedArticle[];
}

const {
  title,
  description,
  category,
  publishDate,
  updatedDate,
  author = siteConfig.author,
  featuredImage,
  imageAlt,
  halteList = [],
  operationalHours,
  fare,
  routeType,
  faqs = [],
  relatedArticles = []
} = Astro.props;

const categoryInfo = siteConfig.categories.find(c => c.slug === category) || {
  slug: category,
  name: category,
  color: 'blue'
};

const breadcrumbs = [
  { name: categoryInfo.name, url: `${siteConfig.url}/kategori/${categoryInfo.slug}/` },
  { name: title, url: `${siteConfig.url}/panduan/${Astro.params.slug}/` }
];

const formattedDate = new Date(publishDate).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

function getArticleGeo(slug: string, articleTitle: string) {
  const s = (slug + ' ' + articleTitle).toLowerCase();
  if (s.includes('yia') || s.includes('bandara yia')) {
    return { placename: 'Bandara Internasional Yogyakarta (YIA Kulon Progo)', latitude: -7.9071, longitude: 110.0565 };
  }
  if (s.includes('prambanan')) {
    return { placename: 'Taman Wisata Candi Prambanan Sleman', latitude: -7.7520, longitude: 110.4914 };
  }
  if (s.includes('borobudur')) {
    return { placename: 'Taman Wisata Candi Borobudur Magelang', latitude: -7.6079, longitude: 110.2038 };
  }
  if (s.includes('parangtritis')) {
    return { placename: 'Kawasan Wisata Pantai Parangtritis Bantul', latitude: -8.0255, longitude: 110.3298 };
  }
  if (s.includes('lempuyangan')) {
    return { placename: 'Stasiun Lempuyangan Yogyakarta', latitude: -7.7906, longitude: 110.3752 };
  }
  if (s.includes('giwangan')) {
    return { placename: 'Terminal Bus Giwangan Kota Yogyakarta', latitude: -7.8346, longitude: 110.3926 };
  }
  if (s.includes('jombor')) {
    return { placename: 'Terminal Bus Jombor Sleman', latitude: -7.7478, longitude: 110.3606 };
  }
  if (s.includes('solo') || s.includes('krl')) {
    return { placename: 'Stasiun Solo Balapan Surakarta', latitude: -7.5583, longitude: 110.8214 };
  }
  if (s.includes('ugm') || s.includes('ring road')) {
    return { placename: 'Kawasan Kampus UGM Bulaksumur Sleman', latitude: -7.7713, longitude: 110.3775 };
  }
  return { placename: 'Stasiun Yogyakarta (Tugu) & Malioboro', latitude: -7.7892, longitude: 110.3635 };
}

const geo = getArticleGeo((Astro.params.slug as string) || '', title);
---

<BaseLayout
  title={`${title} — ${siteConfig.name}`}
  description={description}
  image={featuredImage}
  article={true}
  publishDate={publishDate}
  updatedDate={updatedDate}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  geo={geo}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbs.map(b => ({ label: b.name, href: b.url }))} />

    <!-- Article Header: Authentic Plang Malioboro Signage Style -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <a
          href={`/kategori/${categoryInfo.slug}`}
          class="inline-flex items-center px-3 py-1 rounded-md text-xs font-bold bg-keraton-100 text-keraton-900 border border-keraton-300 hover:bg-keraton-200 transition-colors"
        >
          {categoryInfo.name}
        </a>
        <span class="text-xs text-jogja-600 font-bold">•</span>
        <span class="text-xs font-bold text-slate-600 font-mono">{routeType}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-700 leading-relaxed mb-6 font-normal">
        {description}
      </p>

      <!-- Meta Author & Date with E-E-A-T Verification -->
      <div class="flex flex-wrap items-center justify-between gap-4 py-3.5 border-y-2 border-keraton-100 text-xs sm:text-sm text-slate-600 bg-keraton-50/40 px-3 rounded-lg">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-keraton-800 text-jogja-300 flex items-center justify-center font-bold text-xs border border-jogja-400 font-mono shadow-xs">
            PRJ
          </div>
          <div>
            <span class="font-bold text-slate-900 block">{author}</span>
            <span class="text-[11px] text-slate-500">Tim Observasi Lapangan &amp; Redaksi</span>
          </div>
        </div>

        <div class="flex items-center gap-4 text-xs font-medium">
          <span>Ditinjau: <strong class="text-slate-900">{formattedDate}</strong></span>
          <span class="inline-flex items-center gap-1 text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded font-bold text-[11px]">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Faktual Terverifikasi 2026
          </span>
        </div>
      </div>
    </header>

    <!-- Transit Route Schematic Strip & Operational Summary -->
    <RouteStrip
      title={title}
      category={category}
      halteList={halteList}
      operationalHours={operationalHours}
      fare={fare}
      routeType={routeType}
    />

    <!-- Featured Image -->
    {featuredImage && (
      <div class="my-8 rounded-xl overflow-hidden border-2 border-slate-200 shadow-sm bg-slate-100">
        <img
          src={featuredImage}
          alt={imageAlt || title}
          class="w-full h-auto object-cover max-h-[420px]"
          loading="lazy"
        />
        <div class="p-2.5 text-center text-xs font-medium text-slate-600 bg-paper-100 border-t border-slate-200">
          Dokumentasi rute &amp; diagram jalur: {title}
        </div>
      </div>
    )}

    <!-- In-Article Middle Ad (Safe pre-approval mode) -->
    <AdSlot slotType="in-article" />

    <!-- Main Content Prose -->
    <article class="prose-transit">
      <slot />
    </article>

    <!-- Halte / Station Table -->
    {halteList && halteList.length > 0 && (
      <HalteTable haltes={halteList} title={`Daftar Halte & Rute ${title}`} />
    )}

    <!-- In-Article Bottom Ad (Safe pre-approval mode) -->
    <AdSlot slotType="in-article-bottom" />

    <!-- FAQ Accordion -->
    {faqs && faqs.length > 0 && (
      <FAQSection faqs={faqs} title={`Pertanyaan Umum (FAQ) — ${title}`} />
    )}

    <!-- Kotak Transit Disclaimer & Official Notice (Anti-Misrepresentation AdSense Policy) -->
    <div class="my-10 p-5 rounded-xl bg-amber-50/90 border-2 border-amber-300 text-amber-950 text-xs sm:text-sm leading-relaxed shadow-sm">
      <div class="flex items-start gap-3.5">
        <div class="w-8 h-8 rounded-lg bg-amber-200 text-amber-900 flex items-center justify-center flex-shrink-0 mt-0.5 font-bold">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-amber-950 text-sm mb-1">
            Pemberitahuan Resmi &amp; Batasan Tanggung Jawab Informasi
          </h4>
          <p class="text-xs sm:text-sm text-amber-900 leading-relaxed font-normal">
            <strong>PanduanRuteJogja.com</strong> adalah portal panduan independen utilitas publik dan <strong>bukan merupakan situs resmi</strong> milik Dinas Perhubungan D.I. Yogyakarta, PT Kereta Api Indonesia (Persero), KAI Commuter, maupun PT Railink. Jadwal keberangkatan, rute persilangan, dan tarif resmi dapat disesuaikan sewaktu-waktu oleh otoritas perhubungan terkait kondisi lalu lintas atau regulasi dinas. Selalu lakukan konfirmasi jadwal langsung di stasiun/halte atau via aplikasi resmi (Access by KAI / KRL Access).
          </p>
        </div>
      </div>
    </div>

    <!-- Editorial Integrity / Author Box (AdSense E-E-A-T) -->
    <div class="mt-8 p-6 bg-keraton-50/80 rounded-xl border-2 border-keraton-200 shadow-sm">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-keraton-800 text-jogja-300 flex items-center justify-center font-bold text-base border-2 border-jogja-400 font-mono shadow-xs flex-shrink-0">
          PRJ
        </div>
        <div class="flex-1">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h4 class="text-base font-bold text-slate-900">Ditinjau oleh Dewan Redaksi PanduanRuteJogja</h4>
            <a href="/redaksi" class="text-xs font-bold text-keraton-800 hover:text-keraton-950 underline">
              Lihat Standar Verifikasi &rarr;
            </a>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed font-normal">
            Artikel panduan ini disusun berdasarkan observasi lapangan, pengecekan berkala Gapeka KAI Commuter, regulasi Dinas Perhubungan D.I. Yogyakarta, serta pengujian rute halte secara langsung untuk akurasi data mobilitas publik.
          </p>
        </div>
      </div>
    </div>

    <!-- Rekomendasi Panduan Rute Terkait (Ticket Cards Grid) -->
    {relatedArticles && relatedArticles.length > 0 && (
      <section class="mt-14 pt-10 border-t-2 border-slate-200">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
          <div>
            <div class="flex items-center gap-1.5 mb-1">
              <span class="w-2 h-2 rounded-full bg-keraton-800"></span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-keraton-700">Integrasi Antarmoda</span>
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 tracking-tight">
              Panduan Rute Terkait &amp; Lanjutan Perjalanan
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">
              Jelajahi panduan rute transportasi umum lainnya yang terhubung di wilayah D.I. Yogyakarta.
            </p>
          </div>
          <a
            href={`/kategori/${categoryInfo.slug}`}
            class="text-xs font-bold text-keraton-800 hover:text-keraton-950 transition-colors inline-flex items-center gap-1"
          >
            <span>Semua di {categoryInfo.name}</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {relatedArticles.map((rel) => (
            <a
              href={`/panduan/${rel.slug}`}
              class="ticket-card overflow-hidden flex flex-col justify-between group"
            >
              <div>
                <div class="aspect-[16/9] w-full overflow-hidden bg-slate-100 border-b border-slate-100 relative">
                  <img
                    src={rel.featuredImage}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded text-[10px] font-bold bg-slate-900/80 text-white backdrop-blur-xs font-mono">
                    {rel.routeType}
                  </span>
                </div>
                <div class="p-4">
                  <h4 class="text-sm font-bold text-slate-900 group-hover:text-keraton-800 transition-colors line-clamp-2 leading-snug mb-2">
                    {rel.title}
                  </h4>
                  <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed font-normal">
                    {rel.description}
                  </p>
                </div>
              </div>
              <div class="px-4 py-3 bg-paper-100 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-keraton-800">
                <span class="font-mono text-keraton-900">{rel.fare}</span>
                <span class="text-keraton-800 group-hover:text-keraton-950 flex items-center gap-1">
                  Buka Rute &rarr;
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation Back to Category & Home -->
    <div class="mt-12 pt-6 border-t-2 border-slate-200 flex justify-between items-center text-xs sm:text-sm font-bold">
      <a
        href={`/kategori/${categoryInfo.slug}`}
        class="inline-flex items-center gap-2 text-keraton-800 hover:text-keraton-950 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Kembali ke Panduan {categoryInfo.name}
      </a>
      <a
        href="/#panduan-list"
        class="text-slate-600 hover:text-keraton-900 transition-colors"
      >
        Semua Direktori Rute &rarr;
      </a>
    </div>

  </div>
</BaseLayout>
