---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AdSlot from '../../components/AdSlot.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const allPanduan = await getCollection('panduan');
  return siteConfig.categories.map((cat) => {
    const filtered = allPanduan
      .filter((p) => p.data.category === cat.slug)
      .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
    return {
      params: { category: cat.slug },
      props: { category: cat, articles: filtered },
    };
  });
}

const { category, articles } = Astro.props;

const breadcrumbs = [
  { name: 'Kategori', url: `${siteConfig.url}/` },
  { name: category.name, url: `${siteConfig.url}/kategori/${category.slug}/` },
];
---

<BaseLayout
  title={`Panduan ${category.name} Yogyakarta — ${siteConfig.name}`}
  description={category.description}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbs.map((b) => ({ label: b.name, href: b.url }))} />

    <!-- Category Header -->
    <header class="mb-10 text-center sm:text-left bg-gradient-to-r from-navy-900 to-brand-900 text-white p-6 sm:p-10 rounded-3xl shadow-sm">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white/10 text-brand-200 border border-white/20 mb-4">
        Kategori Transportasi Publik
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Panduan {category.name}
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
        {category.description}
      </p>
      <div class="mt-6 flex items-center gap-4 text-xs text-brand-200">
        <span>Total <strong>{articles.length} Panduan Faktual</strong></span>
        <span>&bull;</span>
        <span>Terverifikasi Lapangan</span>
      </div>
    </header>

    <!-- Ad Slot -->
    <AdSlot slotType="in-article" />

    <!-- Article Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 my-8">
      {articles.map((art) => (
        <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md hover:border-brand-300 transition-all flex flex-col group">
          <a href={`/panduan/${art.slug}`} class="block overflow-hidden relative aspect-[16/9] bg-slate-100">
            <img
              src={art.data.featuredImage}
              alt={art.data.imageAlt || art.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <span class="absolute top-3 left-3 bg-navy-900/80 backdrop-blur-sm text-white text-[11px] font-bold px-2.5 py-1 rounded-md">
              {art.data.routeType}
            </span>
          </a>

          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                <span>{new Date(art.data.publishDate).toLocaleDateString('id-ID', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                <span class="font-semibold text-brand-600">{art.data.fare}</span>
              </div>
              <h2 class="text-lg font-bold text-navy-900 group-hover:text-brand-600 transition-colors line-clamp-2 leading-snug mb-2">
                <a href={`/panduan/${art.slug}`}>
                  {art.data.title}
                </a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4">
                {art.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-medium">
                {art.data.halteList?.length || 0} Titik Halte / Info
              </span>
              <a
                href={`/panduan/${art.slug}`}
                class="inline-flex items-center gap-1 font-bold text-brand-600 hover:text-brand-700"
              >
                <span>Buka Panduan</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Ad Slot Bottom -->
    <AdSlot slotType="in-article-bottom" />

  </div>
</BaseLayout>
