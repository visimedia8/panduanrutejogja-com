---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import HalteFinder from '../components/HalteFinder.astro';
import DepartureBoard from '../components/DepartureBoard.astro';
import { siteConfig } from '../config/site';
import { LINE_ORDER, LINES } from '../lib/lines';

const allPanduan = await getCollection('panduan');
const sortedArticles = allPanduan.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const transJogjaCount = allPanduan.filter((p) => p.data.category === 'trans-jogja').length;
const keretaCount = allPanduan.filter((p) => p.data.category === 'kereta-bandara').length;
const wisataCount = allPanduan.filter((p) => p.data.category === 'tiket-wisata').length;
---

<BaseLayout
  title={`${siteConfig.name} — Panduan Lengkap Rute & Transportasi Publik Yogyakarta`}
  description="Portal navigasi independen terlengkap seputar bus Trans Jogja, jadwal real-time KRL Commuter Line Jogja-Solo, KA Bandara YIA, tarif resmi, dan panduan halte transit."
>
  <!-- Hero Section: Yogyakarta Heritage Wayfinding Console -->
  <section class="relative bg-keraton-950 text-white overflow-hidden py-10 sm:py-14 border-b-4 border-jogja-500">
    <!-- Subtle Heritage Grid Texture -->
    <div class="absolute inset-0 opacity-15 bg-[linear-gradient(to_right,#d4af3715_1px,transparent_1px),linear-gradient(to_bottom,#d4af3715_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        
        <!-- Left Column: Wayfinding Console & Search Tool -->
        <div class="lg:col-span-7 text-left">
          <!-- Authentic Plang Badge (No pulse dot) -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-bold bg-keraton-900 border border-jogja-400 text-jogja-300 mb-4 font-mono shadow-xs">
            <span>DIREKTORI RUTE &amp; JADWAL TERVERIFIKASI 2026</span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight leading-tight text-white mb-2.5">
            Panduan Rute &amp; Transportasi <br class="hidden sm:inline" />
            <span class="text-jogja-300 border-b-2 border-jogja-400 pb-0.5">
              Publik Daerah Istimewa Yogyakarta
            </span>
          </h1>

          <p class="text-xs sm:text-sm text-keraton-100/90 leading-relaxed mb-6">
            Peta koridor bus Trans Jogja, jadwal KRL Commuter Line Jogja–Solo, KA Bandara YIA, integrasi halte Stasiun Tugu, dan panduan tarif resmi anti-tersesat.
          </p>

          <!-- Halte & Transit Point Finder Tool -->
          <HalteFinder />

          <!-- Quick Access Line Badges -->
          <div class="mt-4 flex flex-wrap items-center gap-1.5 text-xs">
            <span class="text-[11px] font-bold uppercase tracking-wider text-jogja-300 font-mono mr-1">
              PINTASAN LINI:
            </span>
            {LINE_ORDER.map((code) => {
              const badge = LINES[code];
              return (
                <a
                  href={`/kategori/${badge.categorySlug}/`}
                  class={`px-2 py-0.5 rounded text-[11px] font-mono font-bold ${badge.bg} ${badge.text} hover:opacity-90 transition-opacity`}
                  title={badge.label}
                >
                  {badge.code}
                </a>
              );
            })}
          </div>
        </div>

        <!-- Right Column: Metro Wayfinding Schematic Map (Stasiun Tugu Interchange) -->
        <div class="lg:col-span-5 hidden lg:block">
          <div class="bg-keraton-900/90 border-2 border-jogja-400/80 rounded-2xl p-4 shadow-2xl relative overflow-hidden">
            <div class="flex items-center justify-between border-b border-keraton-800 pb-2.5 mb-3">
              <span class="text-[11px] font-bold font-mono text-jogja-300 uppercase tracking-widest flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-jogja-400"></span>
                SKEMATIK SIMPUL TRANSIT TUGU
              </span>
              <span class="text-[10px] text-keraton-200 font-mono">D.I. YOGYAKARTA</span>
            </div>

            <!-- Handcrafted Inline SVG Metro Diagram -->
            <div class="w-full aspect-[10/9] flex items-center justify-center">
              <svg
                viewBox="0 0 400 360"
                class="w-full h-full"
                aria-label="Peta Skematik Simpul Transportasi Stasiun Tugu Yogyakarta"
                role="img"
              >
                <title>Peta Skematik Simpul Transportasi Stasiun Tugu Yogyakarta</title>
                <defs>
                  <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
                    <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000" flood-opacity="0.5" />
                  </filter>
                </defs>

                <!-- Background Subtle Guidelines -->
                <circle cx="200" cy="180" r="120" fill="none" stroke="#1b4d3e" stroke-width="1" stroke-dasharray="3,3" opacity="0.6" />

                <!-- Spoke: KA Bandara YIA (West, Cyan) -->
                <line x1="200" y1="180" x2="65" y2="140" stroke="#0891b2" stroke-width="5" stroke-linecap="round" />
                <circle cx="65" cy="140" r="7" fill="#ffffff" stroke="#0891b2" stroke-width="4" />
                <text x="65" y="122" fill="#ecfeff" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">KA BANDARA (YIA)</text>

                <!-- Spoke: KA Prameks Kutoarjo (South-West, Blue) -->
                <line x1="200" y1="180" x2="70" y2="270" stroke="#2563eb" stroke-width="5" stroke-linecap="round" />
                <circle cx="70" cy="270" r="7" fill="#ffffff" stroke="#2563eb" stroke-width="4" />
                <text x="70" y="292" fill="#eff6ff" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">PRAMEKS (KUTOARJO)</text>

                <!-- Spoke: KRL Commuter Line Solo (East, Red) -->
                <line x1="200" y1="180" x2="335" y2="140" stroke="#dc2626" stroke-width="5" stroke-linecap="round" />
                <circle cx="335" cy="140" r="7" fill="#ffffff" stroke="#dc2626" stroke-width="4" />
                <text x="335" y="122" fill="#fef2f2" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">KRL (SOLO BALAPAN)</text>

                <!-- Spoke: Trans Jogja Koridor 1A Prambanan (North-East, Emerald) -->
                <line x1="200" y1="180" x2="320" y2="70" stroke="#059669" stroke-width="5" stroke-linecap="round" />
                <circle cx="320" cy="70" r="7" fill="#ffffff" stroke="#059669" stroke-width="4" />
                <text x="320" y="52" fill="#ecfdf5" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">1A (PRAMBANAN)</text>

                <!-- Spoke: Trans Jogja Koridor 2A Jombor (North, Emerald) -->
                <line x1="200" y1="180" x2="200" y2="55" stroke="#059669" stroke-width="5" stroke-linecap="round" />
                <circle cx="200" cy="55" r="7" fill="#ffffff" stroke="#059669" stroke-width="4" />
                <text x="200" y="40" fill="#ecfdf5" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">2A (JOMBOR / CONDONGCATUR)</text>

                <!-- Spoke: Trans Jogja Koridor 3A / Ring Road (South, Amber) -->
                <line x1="200" y1="180" x2="200" y2="305" stroke="#d97706" stroke-width="5" stroke-linecap="round" />
                <circle cx="200" cy="305" r="7" fill="#ffffff" stroke="#d97706" stroke-width="4" />
                <text x="200" y="326" fill="#fffbeb" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">3A / 4A (GIWANGAN &amp; RING ROAD)</text>

                <!-- Central Hub: STASIUN TUGU & MALIOBORO -->
                <circle cx="200" cy="180" r="32" fill="#09231c" stroke="#d4af37" stroke-width="4" filter="url(#shadow)" />
                <circle cx="200" cy="180" r="26" fill="#1b4d3e" stroke="#d4af37" stroke-width="1.5" stroke-dasharray="2,2" />
                <text x="200" y="176" fill="#d4af37" font-size="9" font-weight="900" font-family="monospace" text-anchor="middle">SIMPUL PUSAT</text>
                <text x="200" y="189" fill="#ffffff" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">TUGU / MALIOBORO</text>
              </svg>
            </div>

            <div class="mt-2 text-center text-[10px] text-keraton-200 font-mono">
              Interchange terintegrasi: Trans Jogja, KA Bandara, KRL, &amp; Prameks
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Moda & Lini Navigation Strip (No -mt-8 overlap hack) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="bg-white rounded-xl border border-keraton-200 shadow-sm p-3 sm:p-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 divide-y md:divide-y-0 md:divide-x divide-slate-100">
        
        <!-- Mode 1: Bus Trans Jogja -->
        <div class="flex items-center justify-between p-2">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-transit-tj"></span>
              <a href="/kategori/trans-jogja" class="text-sm font-extrabold text-slate-900 hover:text-keraton-800 transition-colors">
                Bus Trans Jogja
              </a>
              <span class="text-xs font-mono font-bold text-keraton-800 bg-keraton-50 px-1.5 py-0.2 rounded">
                {transJogjaCount} Panduan
              </span>
            </div>
            <p class="text-[11px] text-slate-500 mt-1">Koridor 1A–5B, Teman Bus, &amp; Halte Transit</p>
          </div>
          <a href="/kategori/trans-jogja" class="text-xs font-bold text-keraton-800 hover:text-keraton-950 p-1">
            &rarr;
          </a>
        </div>

        <!-- Mode 2: Kereta & Bandara -->
        <div class="flex items-center justify-between p-2 md:pl-6">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-transit-yia"></span>
              <a href="/kategori/kereta-bandara" class="text-sm font-extrabold text-slate-900 hover:text-keraton-800 transition-colors">
                Kereta &amp; Bandara
              </a>
              <span class="text-xs font-mono font-bold text-keraton-800 bg-keraton-50 px-1.5 py-0.2 rounded">
                {keretaCount} Panduan
              </span>
            </div>
            <p class="text-[11px] text-slate-500 mt-1">KA Bandara YIA, KRL Jogja–Solo, Prameks, DAMRI</p>
          </div>
          <a href="/kategori/kereta-bandara" class="text-xs font-bold text-keraton-800 hover:text-keraton-950 p-1">
            &rarr;
          </a>
        </div>

        <!-- Mode 3: Tiket & Wisata -->
        <div class="flex items-center justify-between p-2 md:pl-6">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-jogja-500"></span>
              <a href="/kategori/tiket-wisata" class="text-sm font-extrabold text-slate-900 hover:text-keraton-800 transition-colors">
                Tiket &amp; Wisata
              </a>
              <span class="text-xs font-mono font-bold text-keraton-800 bg-keraton-50 px-1.5 py-0.2 rounded">
                {wisataCount} Panduan
              </span>
            </div>
            <p class="text-[11px] text-slate-500 mt-1">E-Money, QRIS, Angkutan Candi Borobudur &amp; Parangtritis</p>
          </div>
          <a href="/kategori/tiket-wisata" class="text-xs font-bold text-keraton-800 hover:text-keraton-950 p-1">
            &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Departure Board Section (High-Contrast Function-First Transit Portal) -->
  <section id="panduan-list" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <DepartureBoard entries={sortedArticles} title="Papan Informasi Rute &amp; Jadwal Resmi" showCategoryTabs={true} />
  </section>

  <!-- Educational & Utility Info (AdSense Quality / E-E-A-T) -->
  <section class="bg-keraton-50/60 border-y border-keraton-100 py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-white text-keraton-800 border border-keraton-200 mb-3 shadow-xs">
          <span>Keuntungan Navigasi Terpadu</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-keraton-950">
          Mengapa Menggunakan Angkutan Umum di Yogyakarta?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed">
          Sistem transportasi publik di Jogja dirancang ramah bagi pejalan kaki dan wisatawan dengan tarif resmi bersubsidi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <div class="ticket-card p-6 border-l-4 border-l-transit-tj">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-base mb-4 font-mono">
            Rp
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Hemat Biaya Signifikan</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Tarif Trans Jogja hanya Rp3.600 flat dan KRL Jogja–Solo Rp8.000. Jauh lebih hemat dibandingkan menyewa kendaraan pribadi saat musim liburan.
          </p>
        </div>

        <div class="ticket-card p-6 border-l-4 border-l-transit-yia">
          <div class="w-10 h-10 rounded-lg bg-cyan-100 text-cyan-800 flex items-center justify-center font-bold text-base mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Jadwal Tepat &amp; Bebas Macet</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            KA Bandara YIA bebas hambatan hanya 39 menit ke Stasiun Tugu. Halte Trans Jogja di Malioboro menurunkan Anda tepat di depan sentra wisata dan belanja.
          </p>
        </div>

        <div class="ticket-card p-6 border-l-4 border-l-jogja-600">
          <div class="w-10 h-10 rounded-lg bg-jogja-100 text-jogja-800 flex items-center justify-center font-bold text-base mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Ramah Lingkungan Kota Budaya</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Mengurangi volume kepadatan kendaraan di kawasan sumbu filosofi Keraton–Tugu–Malioboro dan mendukung kelestarian udara segar Yogyakarta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Ad Slot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
    <AdSlot slotType="in-article-bottom" />
  </div>
</BaseLayout>
