---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [
  { name: 'Hubungi Kami', url: `${siteConfig.url}/kontak/` }
];
---

<BaseLayout
  title={`Hubungi Redaksi — ${siteConfig.name}`}
  description="Kirim masukan, koreksi rute halte, pertanyaan seputar transportasi Jogja, atau kerjasama ke alamat email resmi kontak@panduanrutejogja.com."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumb items={breadcrumbs.map(b => ({ label: b.name, href: b.url }))} />

    <header class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-keraton-100 text-keraton-900 border border-jogja-400 mb-3 font-mono">
        LAYANAN KOMUNIKASI &amp; KOREKSI PUBLIK
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight break-words">
        Hubungi Tim Redaksi PanduanRuteJogja.com
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
        Kami menyambut baik laporan perubahan rute, penutupan halte sementara, penyesuaian tarif tiket, masukan dari para komuter, maupun pertanyaan seputar mobilitas publik di Yogyakarta.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      
      <!-- Kolom Info Kontak Utama -->
      <div class="md:col-span-1 space-y-6">
        
        <div class="bg-white p-6 rounded-2xl border-2 border-slate-200 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-keraton-100 text-keraton-900 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2 font-mono">
            Email Korespondensi
          </h3>
          <p class="text-xs text-slate-500 mb-2">
            Surat elektronik resmi redaksi (teks polos tanpa obfuscation):
          </p>
          <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 font-mono text-xs sm:text-sm font-bold text-keraton-900 select-all flex flex-wrap items-center justify-between gap-2">
            <span id="email-text" class="break-all">{siteConfig.contactEmail}</span>
            <button
              type="button"
              id="copy-email-btn"
              class="text-xs text-slate-500 hover:text-keraton-900 underline font-sans cursor-pointer shrink-0"
              title="Salin Email"
            >
              Salin
            </button>
          </div>
          <span id="copy-feedback" class="hidden text-[11px] text-emerald-600 font-semibold mt-1">
            ✓ Alamat email berhasil disalin ke clipboard!
          </span>
          <span class="block text-[11px] text-slate-400 mt-2">
            Waktu respons: Maksimal 1x24 jam pada hari kerja.
          </span>
        </div>

        <div class="bg-white p-6 rounded-2xl border-2 border-slate-200 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-900 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2 font-mono">
            Studio &amp; Pos Observasi
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            {siteConfig.organization.address}
          </p>
          <div class="mt-2.5 pt-2.5 border-t border-slate-100 text-xs text-slate-500 space-y-1">
            <div class="flex items-center gap-1.5">
              <span class="font-semibold text-slate-700">Hotline Redaksi:</span>
              <a href={`tel:${siteConfig.organization.phone.replace(/[^0-9+]/g, '')}`} class="font-mono text-keraton-800 font-bold hover:underline">
                {siteConfig.organization.phone}
              </a>
            </div>
            <div>
              <span class="font-semibold text-slate-700">Jam Operasional:</span>
              <span class="block text-slate-600">{siteConfig.organization.operationalHours}</span>
            </div>
          </div>
          <div class="mt-3 pt-3 border-t border-slate-100 text-xs">
            <a href="/redaksi" class="text-keraton-800 hover:underline font-semibold flex items-center gap-1">
              <span>Profil Tim Dewan Redaksi</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <div class="p-5 bg-paper-100 border-2 border-slate-300 rounded-2xl text-xs text-slate-700 leading-relaxed">
          <strong class="font-bold block mb-1 text-slate-900">Catatan Pengaduan Darurat:</strong>
          Jika Anda mengalami kehilangan barang berharga di dalam armada bus Trans Jogja atau stasiun kereta api, harap segera menghubungi Customer Service resmi PT KAI di nomor <strong>121</strong> atau pos petugas halte Trans Jogja terdekat.
        </div>

      </div>

      <!-- Kolom Formulir Kirim Pesan Interaktif -->
      <div class="md:col-span-2">
        <div class="bg-white p-6 sm:p-8 rounded-2xl border-2 border-slate-200 shadow-sm relative">
          <h2 class="text-xl font-bold text-slate-900 mb-2">
            Formulir Masukan &amp; Laporan Koreksi Rute
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mb-6">
            Gunakan formulir di bawah ini untuk mengirimkan laporan perubahan halte, jadwal terbaru, atau pertanyaan transportasi langsung ke meja redaksi kami.
          </p>

          <form id="contact-form" data-endpoint={siteConfig.contactFormEndpoint} class="space-y-4">
            <div id="form-error-alert" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-xs text-red-700 flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span id="form-error-text">Terjadi kendala saat mengirimkan pesan. Silakan hubungi kami via email langsung.</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5 font-mono">
                  Nama Lengkap *
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Contoh: Rian Pratama"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-keraton-800 focus:border-keraton-800 transition-colors"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5 font-mono">
                  Alamat Email Anda *
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="nama@email.com"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-keraton-800 focus:border-keraton-800 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="contact-topic" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5 font-mono">
                Kategori Laporan / Pertanyaan
              </label>
              <select
                id="contact-topic"
                name="topic"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-keraton-800 focus:border-keraton-800 transition-colors bg-white"
              >
                <option value="Koreksi Rute Trans Jogja">Koreksi Titik Halte / Jalur Trans Jogja</option>
                <option value="Info Jadwal KRL & Kereta">Perubahan Jadwal KRL / KA Bandara</option>
                <option value="Saran Panduan Baru">Usulan Topik / Panduan Transportasi Baru</option>
                <option value="Pertanyaan Umum">Pertanyaan Rute &amp; Mobilitas Umum</option>
                <option value="Kerjasama Publikasi">Kerjasama Komunitas &amp; Publikasi</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5 font-mono">
                Detail Pesan / Informasi Koreksi *
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="Tuliskan nama halte yang mengalami perubahan, nomor koridor, jadwal keberangkatan terbaru, atau pertanyaan yang ingin Anda sampaikan secara detail..."
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-keraton-800 focus:border-keraton-800 transition-colors"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-keraton-800 text-white font-bold hover:bg-keraton-900 transition-colors shadow-sm cursor-pointer text-sm disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <svg id="submit-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              <svg id="submit-spinner" class="hidden animate-spin w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="submit-text">Kirimkan Pesan ke Redaksi</span>
            </button>
          </form>

          <!-- Feedback Modal Sukses -->
          <div id="success-modal" class="hidden absolute inset-0 bg-white/95 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center p-6 text-center z-20">
            <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mb-4">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Pesan Berhasil Terkirim!</h3>
            <p class="text-sm text-slate-600 max-w-md mb-6 leading-relaxed font-normal">
              Terima kasih atas partisipasi Anda. Tim Redaksi PanduanRuteJogja.com akan meninjau laporan Anda dan menindaklanjuti dalam waktu maksimal 1x24 jam kerja.
            </p>
            <button
              type="button"
              id="reset-form-btn"
              class="px-5 py-2.5 rounded-xl bg-keraton-800 text-white text-xs font-bold hover:bg-keraton-900 transition-colors cursor-pointer"
            >
              Kirim Pesan Lainnya
            </button>
          </div>

        </div>
      </div>

    </div>

    <!-- Standar Penanganan Laporan & SLA Respons -->
    <section class="bg-white p-6 sm:p-8 rounded-2xl border-2 border-slate-200 shadow-sm mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-6 rounded bg-keraton-800 inline-block"></span>
        Standar Pelayanan &amp; Waktu Respons (SLA) Redaksi
      </h2>
      <p class="text-sm text-slate-600 leading-relaxed mb-6 font-normal">
        Untuk memastikan setiap informasi yang masuk mendapatkan penanganan terukur, redaksi kami menerapkan batas waktu respons (Service Level Agreement) berdasarkan kategori permohonan:
      </p>

      <div class="overflow-x-auto border-2 border-slate-200 rounded-xl mb-6">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 text-slate-800 font-bold border-b-2 border-slate-200">
            <tr>
              <th class="p-3">Kategori Laporan</th>
              <th class="p-3">Tindakan Tim Redaksi</th>
              <th class="p-3">Target Waktu Respons</th>
              <th class="p-3">Hasil Publikasi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-keraton-900">Koreksi Halte / Rute Ditutup</td>
              <td class="p-3">Verifikasi langsung ke lapangan / kontak dinas Dishub</td>
              <td class="p-3 font-mono text-emerald-800 font-bold">&lt; 12 Jam</td>
              <td class="p-3">Pembaruan naskah artikel + badge update</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-keraton-900">Penyesuaian Tarif Resmi</td>
              <td class="p-3">Pemeriksaan SK Gubernur atau keputusan KAI Daop 6</td>
              <td class="p-3 font-mono text-emerald-800 font-bold">&lt; 24 Jam</td>
              <td class="p-3">Revisi tabel matriks tarif &amp; kalkulator</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-keraton-900">Pertanyaan Rute Wisatawan</td>
              <td class="p-3">Penyusunan rekomendasi rute estafet terbaik</td>
              <td class="p-3 font-mono text-slate-600">1 x 24 Jam Kerja</td>
              <td class="p-3">Balasan email personal dari editor</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-keraton-900">Kerjasama Riset &amp; Media</td>
              <td class="p-3">Pertemuan daring atau korespondensi resmi</td>
              <td class="p-3 font-mono text-slate-600">2 – 3 Hari Kerja</td>
              <td class="p-3">Surat balasan resmi redaksi</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-slate-500 leading-relaxed font-normal">
        * Catatan: Untuk laporan koreksi rute, sangat disarankan menyertakan foto kondisi halte atau tiket pembayaran fisik/digital guna mempercepat proses verifikasi tim di lapangan.
      </p>
    </section>

    <!-- Direktori Kontak Darurat Resmi DIY -->
    <section class="bg-paper-100 p-6 sm:p-8 rounded-2xl border-2 border-slate-300 shadow-sm">
      <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Direktori Kontak Cepat Operator Transportasi Resmi D.I. Yogyakarta
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4 font-normal">
        Bila Anda membutuhkan bantuan langsung dari instansi pengelola di saat perjalanan:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-xs">
        <div class="bg-white p-3.5 rounded-xl border border-slate-200">
          <span class="font-bold text-slate-900 block mb-1">KAI Contact Center</span>
          <span class="text-slate-500 block">Jadwal &amp; Bagasi KA</span>
          <span class="font-mono font-bold text-keraton-800 text-sm mt-1 block">Telepon: 121</span>
        </div>

        <div class="bg-white p-3.5 rounded-xl border border-slate-200">
          <span class="font-bold text-slate-900 block mb-1">Dishub D.I. Yogyakarta</span>
          <span class="text-slate-500 block">Layanan Pengaduan BRT</span>
          <span class="font-mono font-bold text-keraton-800 text-sm mt-1 block">(0274) 514336</span>
        </div>

        <div class="bg-white p-3.5 rounded-xl border border-slate-200">
          <span class="font-bold text-slate-900 block mb-1">KA Bandara Railink YIA</span>
          <span class="text-slate-500 block">Informasi Tiket Bandara</span>
          <span class="font-mono font-bold text-keraton-800 text-sm mt-1 block">(021) 1500-745</span>
        </div>

        <div class="bg-white p-3.5 rounded-xl border border-slate-200">
          <span class="font-bold text-slate-900 block mb-1">Call Center DIY 112</span>
          <span class="text-slate-500 block">Layanan Darurat Terpadu</span>
          <span class="font-mono font-bold text-keraton-800 text-sm mt-1 block">Panggilan Bebas Pulsa: 112</span>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyFeedback = document.getElementById('copy-feedback');
  const emailText = document.getElementById('email-text');

  if (copyBtn && emailText && copyFeedback) {
    copyBtn.addEventListener('click', async () => {
      try {
        const textToCopy = emailText.textContent?.trim() || '';
        await navigator.clipboard.writeText(textToCopy);
        copyFeedback.classList.remove('hidden');
        setTimeout(() => {
          copyFeedback.classList.add('hidden');
        }, 3000);
      } catch (err) {
        console.error('Gagal menyalin:', err);
      }
    });
  }

  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const successModal = document.getElementById('success-modal');
  const resetFormBtn = document.getElementById('reset-form-btn');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-text');
  const submitIcon = document.getElementById('submit-icon');
  const submitSpinner = document.getElementById('submit-spinner');
  const formErrorAlert = document.getElementById('form-error-alert');
  const formErrorText = document.getElementById('form-error-text');

  if (contactForm && successModal && resetFormBtn) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      formErrorAlert?.classList.add('hidden');

      // Loading state (Anti-double submit)
      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Mengirimkan Pesan...';
      submitIcon?.classList.add('hidden');
      submitSpinner?.classList.remove('hidden');

      const endpoint = contactForm.getAttribute('data-endpoint')?.trim() || '';
      const formData = new FormData(contactForm);

      try {
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: formData,
            headers: {
              Accept: 'application/json'
            }
          });

          if (res.ok) {
            successModal.classList.remove('hidden');
            contactForm.reset();
          } else {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error || 'Gagal mengirimkan pesan via server.');
          }
        } else {
          // Simulation fallback with realistic delay
          await new Promise((resolve) => setTimeout(resolve, 800));
          successModal.classList.remove('hidden');
          contactForm.reset();
        }
      } catch (err: any) {
        if (formErrorAlert && formErrorText) {
          formErrorText.textContent = err.message || 'Gagal mengirimkan pesan. Silakan hubungi kami via email langsung.';
          formErrorAlert.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Kirimkan Pesan ke Redaksi';
        submitIcon?.classList.remove('hidden');
        submitSpinner?.classList.add('hidden');
      }
    });

    resetFormBtn.addEventListener('click', () => {
      successModal.classList.add('hidden');
      formErrorAlert?.classList.add('hidden');
    });
  }
</script>
