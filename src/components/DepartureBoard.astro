---
import type { CollectionEntry } from 'astro:content';
import { getLineBadge, LINE_ORDER } from '../lib/lines';

interface Props {
  entries: CollectionEntry<'panduan'>[];
  title?: string;
  showCategoryTabs?: boolean;
}

const {
  entries = [],
  title = "Papan Informasi Rute & Panduan Perjalanan",
  showCategoryTabs = true
} = Astro.props;

// Sort entries: priority by LINE_ORDER, then title
const getSortIndex = (entry: CollectionEntry<'panduan'>) => {
  const badge = getLineBadge(entry.data.title, entry.data.category);
  const idx = (LINE_ORDER as readonly string[]).indexOf(badge.code);
  return idx === -1 ? 99 : idx;
};

const sortedEntries = [...entries].sort((a, b) => {
  const diff = getSortIndex(a) - getSortIndex(b);
  if (diff !== 0) return diff;
  return a.data.title.localeCompare(b.data.title, 'id');
});

const dateFormatter = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC'
});

const totalCount = sortedEntries.length;
const transJogjaCount = sortedEntries.filter(e => e.data.category === 'trans-jogja').length;
const keretaCount = sortedEntries.filter(e => e.data.category === 'kereta-bandara').length;
const tiketCount = sortedEntries.filter(e => e.data.category === 'tiket-wisata').length;
---

<div class="my-6 bg-white rounded-2xl border-2 border-keraton-200 shadow-ticket overflow-hidden">
  
  <!-- Departure Board Top Bar -->
  <div class="bg-keraton-950 p-4 sm:p-6 border-b-2 border-jogja-500 text-white">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1.5 font-mono">
          <span class="w-2.5 h-2.5 rounded-full bg-jogja-400"></span>
          <span class="text-xs font-bold tracking-widest text-jogja-300 uppercase">
            SISTEM INFORMASI JALUR RESMI
          </span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-keraton-200 mt-1">
          Daftar koridor bus Trans Jogja, jadwal kereta bandara YIA, KRL Commuter Line, dan tarif terverifikasi.
        </p>
      </div>

      <!-- Live Title Search Filter -->
      <div class="w-full sm:w-72">
        <div class="relative">
          <input
            type="text"
            id="board-search-input"
            aria-label="Cari rute pada papan informasi"
            placeholder="Filter nama koridor / tujuan..."
            class="w-full pl-9 pr-3 py-2 text-xs font-medium text-white placeholder:text-keraton-300 bg-keraton-900 border border-keraton-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-jogja-400 font-sans"
          />
          <svg class="w-4 h-4 text-jogja-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Category Filter Tabs (if enabled) -->
    {showCategoryTabs && (
      <div class="mt-5 pt-4 border-t border-keraton-800/80 flex flex-wrap gap-2 text-xs font-semibold">
        <button
          type="button"
          class="board-tab px-3 py-1.5 rounded-lg bg-jogja-500 text-keraton-950 font-bold transition-all cursor-pointer"
          data-category="all"
        >
          Semua Layanan ({totalCount})
        </button>
        <button
          type="button"
          class="board-tab px-3 py-1.5 rounded-lg bg-keraton-900 text-keraton-200 hover:text-white border border-keraton-800 transition-all cursor-pointer"
          data-category="trans-jogja"
        >
          Trans Jogja ({transJogjaCount})
        </button>
        <button
          type="button"
          class="board-tab px-3 py-1.5 rounded-lg bg-keraton-900 text-keraton-200 hover:text-white border border-keraton-800 transition-all cursor-pointer"
          data-category="kereta-bandara"
        >
          Kereta &amp; Bandara ({keretaCount})
        </button>
        <button
          type="button"
          class="board-tab px-3 py-1.5 rounded-lg bg-keraton-900 text-keraton-200 hover:text-white border border-keraton-800 transition-all cursor-pointer"
          data-category="tiket-wisata"
        >
          Tiket &amp; Wisata ({tiketCount})
        </button>
      </div>
    )}
  </div>

  <!-- Board Table Container -->
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse" id="departure-table">
      <thead>
        <tr class="bg-keraton-900/90 text-jogja-300 font-mono text-[11px] uppercase tracking-wider border-b border-keraton-800 hidden sm:table-row">
          <th class="py-3 px-4 w-20">Lini</th>
          <th class="py-3 px-4">Rute / Panduan Perjalanan</th>
          <th class="py-3 px-4 w-44">Jam Operasional</th>
          <th class="py-3 px-4 w-28">Tarif</th>
          <th class="py-3 px-4 w-36">Jenis Moda</th>
          <th class="py-3 px-4 w-32">Verifikasi</th>
          <th class="py-3 px-4 w-24 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 font-sans">
        {sortedEntries.map((entry) => {
          const badge = getLineBadge(entry.data.title, entry.data.category);
          const rawDate = entry.data.updatedDate || entry.data.publishDate;
          const verifiedDate = dateFormatter.format(new Date(rawDate));

          return (
            <tr
              class="board-row hover:bg-paper-100 transition-colors block sm:table-row p-4 sm:p-0 border-b sm:border-b-0 border-slate-100"
              data-category={entry.data.category}
              data-title={entry.data.title.toLowerCase()}
            >
              <!-- Lini Badge -->
              <td class="sm:py-3.5 sm:px-4 sm:table-cell inline-block mb-2 sm:mb-0">
                <span class={`inline-flex items-center justify-center min-w-[42px] px-2 py-1 rounded text-xs font-black font-mono shadow-xs ${badge.bg} ${badge.text}`}>
                  {badge.code}
                </span>
              </td>

              <!-- Title & Link -->
              <td class="sm:py-3.5 sm:px-4 block sm:table-cell">
                <a
                  href={`/panduan/${entry.slug}/`}
                  class="text-sm font-bold text-slate-900 hover:text-keraton-800 transition-colors block leading-snug"
                >
                  {entry.data.title}
                </a>
                <p class="text-xs text-slate-500 line-clamp-1 mt-0.5 sm:hidden">
                  {entry.data.description}
                </p>
              </td>

              <!-- Operational Hours -->
              <td class="sm:py-3.5 sm:px-4 block sm:table-cell mt-2 sm:mt-0 text-xs text-slate-700">
                <span class="sm:hidden font-bold text-slate-500 uppercase mr-1">Jam:</span>
                <span class="font-mono text-slate-800">{entry.data.operationalHours}</span>
              </td>

              <!-- Fare -->
              <td class="sm:py-3.5 sm:px-4 block sm:table-cell text-xs font-bold text-keraton-900 mt-1 sm:mt-0">
                <span class="sm:hidden font-bold text-slate-500 uppercase mr-1">Tarif:</span>
                <span class="font-mono">{entry.data.fare}</span>
              </td>

              <!-- Route Type -->
              <td class="sm:py-3.5 sm:px-4 block sm:table-cell text-xs text-slate-600 mt-1 sm:mt-0">
                <span class="sm:hidden font-bold text-slate-500 uppercase mr-1">Moda:</span>
                <span class="inline-block px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-medium text-[11px]">
                  {entry.data.routeType}
                </span>
              </td>

              <!-- Verified Date -->
              <td class="sm:py-3.5 sm:px-4 block sm:table-cell text-[11px] text-slate-500 mt-1 sm:mt-0">
                <span class="sm:hidden font-bold text-slate-500 uppercase mr-1">Audit:</span>
                <span>{verifiedDate}</span>
              </td>

              <!-- Action Link -->
              <td class="sm:py-3.5 sm:px-4 text-right block sm:table-cell mt-3 sm:mt-0">
                <a
                  href={`/panduan/${entry.slug}/`}
                  class="inline-flex items-center gap-1 text-xs font-bold text-keraton-800 hover:text-keraton-950 hover:underline"
                >
                  <span>Buka</span>
                  <span>&rarr;</span>
                </a>
              </td>
            </tr>
          );
        })}

        <!-- Empty Filter State -->
        <tr id="board-empty-row" class="hidden">
          <td colspan="7" class="py-12 px-4 text-center text-slate-500">
            <p class="text-sm font-semibold text-slate-700">Tidak ada panduan rute yang cocok.</p>
            <p class="text-xs text-slate-500 mt-1">Coba sesuaikan kata kunci pencarian atau pilih tab kategori lain.</p>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Board Footer Summary -->
  <div class="bg-paper-100 p-3 sm:p-4 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-600 font-mono gap-2">
    <div>
      <span>TOTAL LAYANAN AKTIF: <strong>{totalCount} RUTE</strong></span>
    </div>
    <div class="text-[11px] text-slate-500">
      * Jadwal &amp; tarif diperbarui berkala berdasarkan evaluasi Dishub DIY &amp; PT KCI.
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('board-search-input') as HTMLInputElement | null;
    const tabs = document.querySelectorAll('.board-tab');
    const rows = document.querySelectorAll('.board-row');
    const emptyRow = document.getElementById('board-empty-row');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterRows() {
      let visibleCount = 0;

      rows.forEach((row) => {
        const cat = row.getAttribute('data-category') || '';
        const title = row.getAttribute('data-title') || '';

        const catMatches = activeCategory === 'all' || cat === activeCategory;
        const textMatches = !searchQuery || title.includes(searchQuery);

        if (catMatches && textMatches) {
          row.classList.remove('hidden');
          visibleCount++;
        } else {
          row.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyRow?.classList.remove('hidden');
      } else {
        emptyRow?.classList.add('hidden');
      }
    }

    // Category Tabs click
    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const cat = target.getAttribute('data-category') || 'all';
        activeCategory = cat;

        tabs.forEach((t) => {
          t.classList.remove('bg-jogja-500', 'text-keraton-950', 'font-bold');
          t.classList.add('bg-keraton-900', 'text-keraton-200', 'border', 'border-keraton-800');
        });

        target.classList.remove('bg-keraton-900', 'text-keraton-200', 'border', 'border-keraton-800');
        target.classList.add('bg-jogja-500', 'text-keraton-950', 'font-bold');

        filterRows();
      });
    });

    // Search input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterRows();
    });
  });
</script>
