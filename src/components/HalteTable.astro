---
interface HalteItem {
  name: string;
  location?: string;
  transit?: string;
}

interface Props {
  title?: string;
  haltes: HalteItem[];
  routeDirection?: string;
}

const { title = "Daftar Titik Pemberhentian & Halte Transit", haltes = [], routeDirection } = Astro.props;
---

<div class="my-8 bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
  <div class="bg-gradient-to-r from-navy-900 to-brand-800 p-4 sm:p-5 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-2">
    <div>
      <h3 class="text-base sm:text-lg font-bold flex items-center gap-2">
        <svg class="w-5 h-5 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {title}
      </h3>
      {routeDirection && (
        <p class="text-xs text-brand-100 mt-0.5">
          Arah Perjalanan: <span class="font-semibold text-white">{routeDirection}</span>
        </p>
      )}
    </div>
    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-white/10 text-white w-fit border border-white/20">
      Total {haltes.length} Titik Halte
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-sm">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500 font-semibold">
          <th class="py-3 px-4 w-14 text-center">No</th>
          <th class="py-3 px-4">Nama Halte / Stasiun</th>
          <th class="py-3 px-4">Titik Acuan / Lokasi</th>
          <th class="py-3 px-4">Koneksi Antarmoda / Transit</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-slate-700">
        {haltes.map((halte, idx) => (
          <tr class="hover:bg-brand-50/50 transition-colors">
            <td class="py-3 px-4 text-center font-mono text-xs font-semibold text-slate-500">
              {idx + 1}
            </td>
            <td class="py-3 px-4 font-semibold text-navy-900">
              {halte.name}
            </td>
            <td class="py-3 px-4 text-slate-600 text-xs sm:text-sm">
              {halte.location || "-"}
            </td>
            <td class="py-3 px-4">
              {halte.transit ? (
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-100 text-brand-800 border border-brand-200">
                  <svg class="w-3 h-3 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                  </svg>
                  {halte.transit}
                </span>
              ) : (
                <span class="text-xs text-slate-400 italic">Pemberhentian Biasa</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="p-3 bg-slate-50 border-t border-slate-200 text-xs text-slate-500 flex items-center justify-between">
    <span>* Pastikan melambaikan tangan saat menunggu di halte portabel tepi jalan.</span>
    <span class="hidden sm:inline">Tarif flat Rp3.600 (Trans Jogja)</span>
  </div>
</div>
