  }
};

function calculateJourney() {
  const originSelect = document.getElementById('calc-origin') as HTMLSelectElement | null;
  const destSelect = document.getElementById('calc-destination') as HTMLSelectElement | null;
  
  if (!originSelect || !destSelect) return;

  const origin = originSelect.value;
  const destination = destSelect.value;
  const key = `${origin}-${destination}`;

  const modeBadge = document.getElementById('res-mode-badge');
  const fareEl = document.getElementById('res-fare');
  const studentFareEl = document.getElementById('res-student-fare');
  const timeEl = document.getElementById('res-time');
  const paymentEl = document.getElementById('res-payment');
  const guidanceEl = document.getElementById('res-guidance');
  const guideLink = document.getElementById('res-guide-link') as HTMLAnchorElement | null;

  if (origin === destination) {
    if (modeBadge) modeBadge.textContent = 'Lokasi Asal & Tujuan Sama';
    if (fareEl) fareEl.textContent = 'Rp0';
    if (studentFareEl) studentFareEl.textContent = 'Titik Berada di Kawasan yang Sama';
    if (timeEl) timeEl.textContent = '0 Menit';
    if (paymentEl) paymentEl.textContent = 'Tidak Memerlukan Angkutan';
    if (guidanceEl) guidanceEl.textContent = 'Titik keberangkatan dan tujuan yang Anda pilih berada pada simpul lokasi yang sama. Silakan pilih destinasi berbeda.';
    if (guideLink) guideLink.href = '/kategori/trans-jogja/';
    return;
  }

  const data = JOURNEY_DB[key];

  if (data) {
    if (modeBadge) modeBadge.textContent = data.primaryMode;
    if (fareEl) fareEl.textContent = data.fare;
    if (studentFareEl) studentFareEl.textContent = `Tarif Pelajar: ${data.studentFare}`;
    if (timeEl) timeEl.textContent = data.time;
    if (paymentEl) paymentEl.textContent = data.payment;
    if (guidanceEl) guidanceEl.textContent = data.guidance;
    if (guideLink) guideLink.href = data.guideUrl;
  } else {
    // Dynamic Intelligent Multimodal Fallback for other combinations
    if (modeBadge) modeBadge.textContent = 'Trans Jogja Jaringan BRT / Transit Tugu';
    if (fareEl) fareEl.textContent = 'Rp3.600 – Rp8.000';
    if (studentFareEl) studentFareEl.textContent = 'Tarif Subsidi Non-Tunai Resmi';
    if (timeEl) timeEl.textContent = '30 – 60 Menit';
    if (paymentEl) paymentEl.textContent = 'QRIS & Kartu Uang Elektronik';
    if (guidanceEl) guidanceEl.textContent = 'Untuk rute ini, gunakan bus Trans Jogja menuju simpul transit terdekat (Halte Malioboro atau Terminal Jombor/Giwangan) untuk melanjutkan ke tujuan akhir Anda.';
    if (guideLink) guideLink.href = '/panduan/cara-transit-dan-pindah-bus-trans-jogja/';
  }
}

// Bind event listeners
const originSelect = document.getElementById('calc-origin');
const destSelect = document.getElementById('calc-destination');

if (originSelect && destSelect) {
  originSelect.addEventListener('change', calculateJourney);
  destSelect.addEventListener('change', calculateJourney);
}

// Preset buttons
const presetBtns = document.querySelectorAll('.route-preset-btn');
presetBtns.forEach((btn) => {
  btn.addEventListener('click', () => {
    const orig = btn.getAttribute('data-origin');
    const dest = btn.getAttribute('data-destination');
    if (orig && dest && originSelect && destSelect) {
      (originSelect as HTMLSelectElement).value = orig;
      (destSelect as HTMLSelectElement).value = dest;
      calculateJourney();
    }
  });
});

// Run initial calculation on load
calculateJourney();
</script>
