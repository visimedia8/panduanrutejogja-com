    guideUrl: '/panduan/lokasi-halte-trans-jogja-terdekat-stasiun-tugu-lempuyangan/'
  },

  // Terminal Jombor origins
  'jombor-malioboro': {
    primaryMode: 'Trans Jogja Koridor 2A / 2B',
    fare: 'Rp3.600 (Flat Sekali Jalan)',
    studentFare: 'Rp2.000',
    time: '25 – 35 Menit',
    payment: 'QRIS & Kartu Uang Elektronik',
