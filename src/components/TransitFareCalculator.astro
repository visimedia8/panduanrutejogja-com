---
// TransitFareCalculator.astro - Kalkulator Estimasi Tarif & Rute Transit DIY
---

<div id="kalkulator-tarif" class="my-8 bg-white rounded-2xl border-2 border-keraton-300 shadow-ticket overflow-hidden">
  
  <!-- Header Bar -->
  <div class="bg-keraton-950 p-4 sm:p-6 border-b-2 border-jogja-500 text-white">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 mb-1.5 font-mono">
          <span class="w-2.5 h-2.5 rounded-full bg-jogja-400"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-jogja-300">
            UTILITAS INTERAKTIF KOMUTER &amp; WISATAWAN
          </span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
          Kalkulator Estimasi Tarif &amp; Rute Transit DIY
        </h2>
        <p class="text-xs sm:text-sm text-keraton-200 mt-1">
          Hitung rincian ongkos resmi, estimasi durasi perjalanan, serta simpul transit halte antarmoda di Daerah Istimewa Yogyakarta.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-keraton-900 border border-jogja-400/80 text-[11px] font-mono text-jogja-300 font-bold whitespace-nowrap">
          TARIF RESMI 2026
        </span>
      </div>
    </div>
  </div>

  <div class="p-4 sm:p-6 lg:p-8 bg-paper-50/60">
    
    <!-- Quick Route Chips -->
    <div class="mb-6">
      <span class="text-xs font-bold font-mono text-keraton-900 uppercase tracking-wider block mb-2.5">
        PILIHAN RUTE POPULER WISATAWAN &amp; KOMUTER:
      </span>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class="route-preset-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-keraton-900 hover:border-keraton-600 hover:bg-keraton-50 transition-all cursor-pointer shadow-2xs"
          data-origin="yia"
          data-destination="malioboro"
        >
          Bandara YIA ➔ Malioboro
        </button>
        <button
          type="button"
          class="route-preset-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-keraton-900 hover:border-keraton-600 hover:bg-keraton-50 transition-all cursor-pointer shadow-2xs"
          data-origin="tugu"
          data-destination="prambanan"
        >
          Stasiun Tugu ➔ Candi Prambanan
        </button>
        <button
          type="button"
          class="route-preset-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-keraton-900 hover:border-keraton-600 hover:bg-keraton-50 transition-all cursor-pointer shadow-2xs"
          data-origin="tugu"
          data-destination="borobudur"
        >
          Stasiun Tugu ➔ Candi Borobudur
        </button>
        <button
          type="button"
          class="route-preset-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-keraton-900 hover:border-keraton-600 hover:bg-keraton-50 transition-all cursor-pointer shadow-2xs"
          data-origin="solo"
          data-destination="malioboro"
        >
          Solo Balapan ➔ Malioboro
        </button>
        <button
          type="button"
          class="route-preset-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-keraton-900 hover:border-keraton-600 hover:bg-keraton-50 transition-all cursor-pointer shadow-2xs"
          data-origin="giwangan"
          data-destination="parangtritis"
        >
          Terminal Giwangan ➔ Pantai Parangtritis
        </button>
        <button
          type="button"
          class="route-preset-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-keraton-900 hover:border-keraton-600 hover:bg-keraton-50 transition-all cursor-pointer shadow-2xs"
          data-origin="tugu"
          data-destination="ugm"
        >
          Stasiun Tugu ➔ Kampus UGM
        </button>
      </div>
    </div>

    <!-- Selection Controls Form -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-6">
      
      <!-- Titik Keberangkatan -->
      <div>
        <label for="calc-origin" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2 font-mono">
          1. Titik Keberangkatan (Asal)
        </label>
        <div class="relative">
          <select
            id="calc-origin"
            class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 text-sm font-semibold text-slate-800 bg-white focus:outline-none focus:border-keraton-800 focus:ring-2 focus:ring-keraton-800/20 transition-all cursor-pointer appearance-none"
          >
            <option value="yia">Bandara Internasional Yogyakarta (YIA Kulon Progo)</option>
            <option value="tugu" selected>Stasiun Yogyakarta (Tugu / Malioboro)</option>
            <option value="lempuyangan">Stasiun Lempuyangan (Kereta Api Ekonomi)</option>
            <option value="malioboro">Kawasan Malioboro / Titik Nol Kilometer</option>
            <option value="giwangan">Terminal Bus Giwangan (Yogyakarta Selatan)</option>
            <option value="jombor">Terminal Bus Jombor (Sleman / Ring Road Utara)</option>
            <option value="solo">Stasiun Solo Balapan / Surakarta</option>
          </select>
          <div class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Titik Tujuan -->
      <div>
        <label for="calc-destination" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2 font-mono">
          2. Titik Tujuan Perjalanan
        </label>
        <div class="relative">
          <select
            id="calc-destination"
            class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 text-sm font-semibold text-slate-800 bg-white focus:outline-none focus:border-keraton-800 focus:ring-2 focus:ring-keraton-800/20 transition-all cursor-pointer appearance-none"
          >
            <option value="malioboro">Malioboro &amp; Titik Nol KM</option>
            <option value="prambanan" selected>Taman Wisata Candi Prambanan</option>
            <option value="borobudur">Kawasan Candi Borobudur (Magelang)</option>
            <option value="parangtritis">Kawasan Wisata Pantai Parangtritis</option>
            <option value="yia">Bandara Internasional Yogyakarta (YIA)</option>
            <option value="ugm">Kampus UGM / UNY Bulaksumur</option>
            <option value="solo">Stasiun Solo Balapan (Surakarta)</option>
          </select>
          <div class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

    </div>

    <!-- Result Card Container -->
    <div id="calc-result-box" class="bg-white rounded-xl border-2 border-keraton-800 shadow-md p-5 sm:p-7 relative overflow-hidden">
      
      <!-- Top Line: Moda & Status -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200">
        <div>
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 block">
            KOMBINASI MODA TERBAIK:
          </span>
          <div id="res-mode-badge" class="mt-1 inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs sm:text-sm font-bold bg-keraton-900 text-jogja-300 font-mono">
            Trans Jogja Koridor 1A
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Jalur Terverifikasi Lapangan
          </span>
        </div>
      </div>

      <!-- Core Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-5">
        
        <!-- Total Ongkos -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider block mb-1">
            TOTAL ESTIMASI ONGKOS
          </span>
          <div id="res-fare" class="text-xl sm:text-2xl font-black text-keraton-900 font-mono">
            Rp3.600
          </div>
          <span id="res-student-fare" class="text-[11px] text-slate-600 block mt-0.5">
            Tarif Pelajar: Rp2.000
          </span>
        </div>

        <!-- Durasi Tempuh -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider block mb-1">
            ESTIMASI WAKTU TEMPUH
          </span>
          <div id="res-time" class="text-xl sm:text-2xl font-black text-slate-900 font-mono">
            40 – 50 Menit
          </div>
          <span class="text-[11px] text-slate-600 block mt-0.5">
            Tergantung kondisi jam sibuk
          </span>
        </div>

        <!-- Metode Pembayaran -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider block mb-1">
            METODE BAYAR VALID
          </span>
          <div id="res-payment" class="text-xs font-bold text-slate-800 leading-snug">
            QRIS &amp; Kartu Uang Elektronik
          </div>
          <span class="text-[11px] text-slate-500 block mt-0.5">
            Flazz, e-Money, TapCash, Brizzi
          </span>
        </div>

      </div>

      <!-- Step by Step Guidance -->
      <div class="p-4 rounded-xl bg-keraton-50/70 border border-keraton-200/80 mb-5">
        <span class="text-xs font-bold font-mono text-keraton-900 uppercase tracking-wider block mb-2 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-keraton-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          PANDUAN SIMPUL TRANSIT &amp; PERJALANAN:
        </span>
        <p id="res-guidance" class="text-xs sm:text-sm text-slate-700 leading-relaxed">
          Naik Trans Jogja Koridor 1A dari Halte Mangkubumi 1 (sebelah timur Stasiun Tugu) langsung menuju halte akhir Terminal Prambanan tanpa perlu transit berpindah bus.
        </p>
      </div>

      <!-- Bottom Action Link -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-slate-100">
        <span class="text-xs text-slate-500">
          Ingin melihat daftar halte lengkap dan jam headway terperinci?
        </span>
        <a
          id="res-guide-link"
          href="/panduan/rute-halte-trans-jogja-koridor-1a-prambanan-malioboro/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-keraton-800 text-white font-bold text-xs hover:bg-keraton-900 transition-colors shadow-xs"
        >
          <span>Buka Panduan Rute Terkait</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</div>

